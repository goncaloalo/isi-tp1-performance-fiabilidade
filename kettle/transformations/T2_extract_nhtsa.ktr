    <name>Validar resposta NHTSA</name>
    <type>ScriptValueMod</type>
    <description>Valida o estado HTTP, a sintaxe JSON e o campo Count antes do parsing.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
