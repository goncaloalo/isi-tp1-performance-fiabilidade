    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Validar HTTP e JSON</jsScript_name>
        <jsScript_script>var api_error_type = "ERRO";
var nhtsa_recalls_count = null;
var status_num = parseInt(String(http_status), 10);

if (status_num >= 200 &amp;&amp; status_num &lt; 300) {
  try {
    var payload = JSON.parse(String(resposta_json));
    if (payload !== null &amp;&amp; typeof payload.Count === "number" &amp;&amp;
        isFinite(payload.Count) &amp;&amp; payload.Count >= 0 &amp;&amp;
        Math.floor(payload.Count) === payload.Count) {
      nhtsa_recalls_count = payload.Count;
      api_error_type = "OK";
    }
  } catch (e) {
    api_error_type = "ERRO";
  }
}</jsScript_script>
      </jsScript>
    </jsScripts>
